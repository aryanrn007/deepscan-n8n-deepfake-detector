    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-3.5-flash-lite"
        },
        "text": "You are a deepfake and AI-generated image detector. Examine this image for artifacts such as unnatural skin texture, inconsistent lighting, warped edges, distorted hands or teeth, and background anomalies. Respond ONLY with JSON: {\"verdict\": \"FAKE\" or \"REAL\", \"confidence\": number from 0 to 100, \"reason\": \"one short sentence\"}",
        "inputType": "binary",
        "binaryPropertyName": "image",
        "options": {
          "maxOutputTokens": 1024
        }
      },
      "id": "887378ee-5383-46a5-8dc1-12f236908f7d",
      "name": "Analyze Image with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        224,
        192
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "aYllaAVXMCMMMyge",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Collect the text Gemini returned (handles simplified and raw shapes).\nfunction collectText(j) {\n  if (!j) return '';\n  if (typeof j === 'string') return j;\n  if (typeof j.text === 'string') return j.text;\n  if (j.content && Array.isArray(j.content.parts)) {\n    return j.content.parts.map(p => p.text || '').join('');\n  }\n  if (Array.isArray(j.candidates)) {\n    return j.candidates.map(c => collectText(c)).join('');\n  }\n  if (Array.isArray(j.parts)) return j.parts.map(p => p.text || '').join('');\n  return '';\n}\n\nconst raw = $input.all().map(i => collectText(i.json)).join('').trim();\nif (!raw) {\n  throw new Error('Gemini returned no text: ' + JSON.stringify($input.first().json));\n}\n\n// Strip markdown fences, then take the first {...} block.\nlet cleaned = raw.replace(/```(?:json)?/gi, '').trim();\nconst start = cleaned.indexOf('{');\nconst end = cleaned.lastIndexOf('}');\nif (start !== -1 && end > start) cleaned = cleaned.slice(start, end + 1);\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Could not parse Gemini JSON: ' + raw);\n}\n\nconst verdict = /fake/i.test(String(parsed.verdict || '')) ? 'FAKE' : 'REAL';\nlet confidence = parseFloat(String(parsed.confidence ?? '').replace(/[^0-9.]/g, ''));\nif (isNaN(confidence)) confidence = 0;\nif (confidence > 0 && confidence <= 1) confidence = confidence * 100;\nconfidence = Math.round(Math.min(100, Math.max(0, confidence)) * 10) / 10;\n\nlet filename = 'unknown';\ntry {\n  filename = $('Upload Image').first().binary?.image?.fileName || 'unknown';\n} catch (e) {}\n\nreturn [{\n  json: {\n    verdict,\n    confidence,\n    label: String(parsed.reason || 'No reason given'),\n    filename,\n  },\n}];"
      },
      "id": "4065d5a6-0c67-4867-a894-cc7df6342628",
      "name": "Parse Result",
